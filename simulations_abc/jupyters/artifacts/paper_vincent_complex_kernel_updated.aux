\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Efficiency for the optimized variable \(z\) under threshold stopping. Each cell reports \(V_{P^{\pi }_z}(z)/V_K(z)\). Light cells close to one indicate that no meaningful improvement over the real-valued \(P^{\pi }\) reference was found. Colored cells indicate scenarios where ABC found a candidate complex kernel with smaller computed HT variance.}}{4}{}\protected@file@percent }
\newlabel{fig:abc-threshold-efficiency}{{1}{4}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Iteration at which the search stopped. Colored cells reached the \(z\)-efficiency threshold before \(1000\) iterations; the number is the first reported stopping iteration. Grey cells did not reach the threshold and therefore stopped at the maximum iteration limit.}}{5}{}\protected@file@percent }
\newlabel{fig:abc-threshold-stopping}{{2}{5}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of the \(z\)-optimized kernel on the companion variable \(y\). Each cell reports \(V_{P^{\pi }_y}(y)/V_K(y)\), where \(P^{\pi }_y\) is the Vincent reference built from the \(y/\pi \) ordering. Values below one show that the \(z\)-optimized kernel is worse than the \(y\)-specific real-valued reference for estimating \(y\).}}{5}{}\protected@file@percent }
\newlabel{fig:abc-auxiliary-efficiency}{{3}{5}{}{figure.3}{}}
\bibcite{BasturkKaraboga2006}{{1}{2006}{{Basturk and Karaboga}}{{}}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Correlation between the HT-scaled variables \(y/\pi \) and \(z/\pi \). The raw correlation \(r(y,z)\) is fixed by row, but the transformed correlation can change substantially once the inclusion probabilities are introduced.}}{6}{}\protected@file@percent }
\newlabel{fig:abc-transformed-correlation}{{4}{6}{}{figure.4}{}}
